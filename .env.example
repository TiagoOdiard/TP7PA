# --- Kafka ---
# Local (servicios corriendo con npm run dev):
KAFKA_BROKERS=localhost:9092
# Dentro de docker compose se sobreescribe a kafka:29092
KAFKA_CLIENT_ID=rutasur

# --- MongoDB ---
# Local: replica set de un nodo iniciado por docker compose (mongo-init).
MONGO_URI=mongodb://localhost:27017/rutasur?replicaSet=rs0&directConnection=true
MONGO_DB=rutasur

# --- Simulador ---
# 1 hora simulada = 30 segundos reales (factor 120x)
SIM_SPEED=120
# Envios por minuto real (volumen de la demo; la consigna sugiere 20)
SIM_RATE=20
SIM_SEED=42
# Hora simulada de arranque (zona America/Argentina/Buenos_Aires)
SIM_START_HOUR=08
SIM_TZ=America/Argentina/Buenos_Aires

# --- Puertos ---
SIMULATOR_PORT=4000
ANALYTICS_PORT=4001
PROJECTOR_PORT=4002
NOTIFICATIONS_PORT=4003
RESCHEDULER_PORT=4004
SLA_MONITOR_PORT=4005
WEB_PORT=3000

# --- Web ---
# URL interna del simulador usada por el panel de demo
SIMULATOR_URL=http://localhost:4000
ANALYTICS_URL=http://localhost:4001
PROJECTOR_URL=http://localhost:4002
NOTIFICATIONS_URL=http://localhost:4003
RESCHEDULER_URL=http://localhost:4004
MONITOR_URL=http://localhost:4005

# --- Observabilidad ---
LOG_LEVEL=info
