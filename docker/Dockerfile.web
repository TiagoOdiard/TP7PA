FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY services/simulator/package.json ./services/simulator/
COPY services/projector/package.json ./services/projector/
COPY services/notifications/package.json ./services/notifications/
COPY services/rescheduler/package.json ./services/rescheduler/
COPY services/sla-monitor/package.json ./services/sla-monitor/
COPY services/analytics/package.json ./services/analytics/
COPY apps/web/package.json ./apps/web/
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
# Se copia el monorepo completo (sin node_modules ni .next por .dockerignore)
# para que los manifiestos de todos los workspaces existan al compilar.
COPY . .
RUN npm run build -w @rutasur/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
